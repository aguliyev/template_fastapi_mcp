#!/usr/bin/env bash
set -euo pipefail

# Validate a single secret file without printing values.
# Usage: check-one <env-name> <path>
check_one() {
  local env_name="$1"
  local file="$2"
  local user_count=0
  local password_count=0
  local user_value=""
  local password_value=""
  local line key value

  if [[ ! -f "$file" ]]; then
    printf 'Missing secret file for %s\n' "$env_name" >&2
    return 1
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    case "$line" in
      POSTGRES_USER=*)
        user_count=$((user_count + 1))
        value="${line#POSTGRES_USER=}"
        user_value="$value"
        ;;
      POSTGRES_PASSWORD=*)
        password_count=$((password_count + 1))
        value="${line#POSTGRES_PASSWORD=}"
        password_value="$value"
        ;;
      *)
        printf 'Invalid entry in secret file for %s\n' "$env_name" >&2
        return 1
        ;;
    esac
  done < "$file"

  if [[ "$user_count" -ne 1 || "$password_count" -ne 1 ]]; then
    printf 'Secret file for %s must define POSTGRES_USER and POSTGRES_PASSWORD exactly once\n' "$env_name" >&2
    return 1
  fi
  if [[ -z "$user_value" || -z "$password_value" ]]; then
    printf 'Secret file for %s has empty credentials\n' "$env_name" >&2
    return 1
  fi
  case "$user_value:$password_value" in
    replace_me_dev:*|replace_me_test:*|*:replace-me)
      printf 'Secret file for %s still contains placeholder credentials\n' "$env_name" >&2
      return 1
      ;;
  esac

  # Require mode 0600 where the host supports POSIX modes.
  if mode="$(stat -c '%a' "$file" 2>/dev/null)"; then
    if [[ "$mode" != "600" ]]; then
      printf 'Secret file for %s must have mode 0600\n' "$env_name" >&2
      return 1
    fi
  elif stat_output="$(stat -f '%Lp' "$file" 2>/dev/null)"; then
    if [[ "$stat_output" != "600" ]]; then
      printf 'Secret file for %s must have mode 0600\n' "$env_name" >&2
      return 1
    fi
  fi
  return 0
}

get_value() {
  local file="$1" key="$2" line
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      "$key"=*) printf '%s' "${line#"$key"=}"; return 0 ;;
    esac
  done < "$file"
  return 1
}

usage() {
  printf 'Usage: check-secrets {dev|test|all}\n' >&2
  exit 2
}

[[ $# -eq 1 ]] || usage
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

case "$1" in
  dev)
    check_one dev "$project_root/etc/dev/secrets/.env"
    ;;
  test)
    check_one test "$project_root/etc/test/secrets/.env"
    ;;
  all)
    check_one dev "$project_root/etc/dev/secrets/.env" || exit 1
    check_one test "$project_root/etc/test/secrets/.env" || exit 1
    dev_user="$(get_value "$project_root/etc/dev/secrets/.env" POSTGRES_USER)"
    dev_password="$(get_value "$project_root/etc/dev/secrets/.env" POSTGRES_PASSWORD)"
    test_user="$(get_value "$project_root/etc/test/secrets/.env" POSTGRES_USER)"
    test_password="$(get_value "$project_root/etc/test/secrets/.env" POSTGRES_PASSWORD)"
    if [[ "$dev_user" == "$test_user" || "$dev_password" == "$test_password" ]]; then
      printf 'Development and test credentials must differ\n' >&2
      exit 1
    fi
    ;;
  *) usage ;;
esac
